<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!--
	Keep defaults, just add a consistent pattern with requestId from MDC.
	If you later move to JSON logs, swap this file for logstash/logback encoder config.
	-->

	<property name="CONSOLE_LOG_PATTERN"
		value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [%X{requestId:-}] %logger{36} - %msg%n" />

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>${CONSOLE_LOG_PATTERN}</pattern>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="CONSOLE" />
	</root>
</configuration>
